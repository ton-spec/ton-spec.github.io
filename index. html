<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>3D Solar System – Tonny Wanjala Mulati</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #000;
    overflow: hidden;
    font-family: 'Rajdhani', sans-serif;
    color: #fff;
    cursor: grab;
  }
  body:active { cursor: grabbing; }

  #canvas-container { width: 100vw; height: 100vh; position: relative; }
  canvas { display: block; }

  /* HUD Overlay */
  #hud {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 10;
  }

  /* Title */
  #title-bar {
    position: fixed; top: 0; left: 0; right: 0;
    padding: 18px 30px;
    background: linear-gradient(180deg, rgba(0,0,0,0.85) 0%, transparent 100%);
    display: flex; align-items: center; justify-content: space-between;
  }
  #title-bar h1 {
    font-family: 'Orbitron', monospace;
    font-size: clamp(14px, 2vw, 22px);
    font-weight: 900;
    letter-spacing: 3px;
    background: linear-gradient(90deg, #FFD700, #FFA500, #FF6B00);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    text-shadow: none;
  }
  #author-tag {
    font-family: 'Orbitron', monospace;
    font-size: clamp(9px, 1.2vw, 13px);
    font-weight: 400;
    letter-spacing: 2px;
    color: #aaa;
    border: 1px solid rgba(255,200,50,0.3);
    padding: 5px 14px;
    border-radius: 20px;
    background: rgba(255,180,0,0.05);
  }
  #author-tag span { color: #FFD700; }

  /* Planet Info Panel */
  #info-panel {
    position: fixed; bottom: 80px; left: 30px;
    background: rgba(0,5,20,0.85);
    border: 1px solid rgba(100,180,255,0.2);
    border-radius: 12px;
    padding: 16px 22px;
    min-width: 220px;
    backdrop-filter: blur(10px);
    transition: opacity 0.4s;
    pointer-events: none;
  }
  #info-panel h2 {
    font-family: 'Orbitron', monospace;
    font-size: 16px; font-weight: 700;
    letter-spacing: 2px; margin-bottom: 8px;
    color: #64b4ff;
  }
  #info-panel .stat {
    font-size: 12px; letter-spacing: 1px;
    color: #aac8e8; line-height: 1.9;
  }
  #info-panel .stat span { color: #fff; font-weight: 600; }

  /* Controls Legend */
  #controls {
    position: fixed; bottom: 24px; right: 24px;
    display: flex; gap: 10px; align-items: center;
    font-size: 11px; letter-spacing: 1px; color: #556;
  }
  .ctrl-key {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 5px; padding: 3px 8px;
    font-family: 'Orbitron', monospace; font-size: 9px;
    color: #889;
  }

  /* Speed controls */
  #speed-bar {
    position: fixed; bottom: 24px; left: 30px;
    display: flex; align-items: center; gap: 12px;
    pointer-events: all;
  }
  #speed-bar label {
    font-family: 'Orbitron', monospace;
    font-size: 9px; letter-spacing: 2px; color: #556;
  }
  #speed-slider {
    -webkit-appearance: none; appearance: none;
    width: 130px; height: 3px;
    background: linear-gradient(90deg, #FFD700, #FF6B00);
    border-radius: 2px; outline: none; cursor: pointer;
  }
  #speed-slider::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 14px; height: 14px; border-radius: 50%;
    background: #FFD700; cursor: pointer;
    box-shadow: 0 0 8px rgba(255,215,0,0.8);
  }
  #speed-val {
    font-family: 'Orbitron', monospace;
    font-size: 10px; color: #FFD700; min-width: 28px;
  }

  /* Hover tooltip */
  #tooltip {
    position: fixed; padding: 6px 12px;
    background: rgba(0,10,30,0.9);
    border: 1px solid rgba(100,180,255,0.3);
    border-radius: 6px; font-size: 11px;
    font-family: 'Orbitron', monospace;
    color: #64b4ff; letter-spacing: 1px;
    pointer-events: none; display: none;
    transform: translate(-50%, -130%);
    white-space: nowrap;
  }

  /* Loading screen */
  #loader {
    position: fixed; inset: 0; z-index: 100;
    background: #000;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 24px;
  }
  #loader h2 {
    font-family: 'Orbitron', monospace;
    font-size: 20px; letter-spacing: 4px;
    background: linear-gradient(90deg,#FFD700,#FF6B00);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  }
  #loader-bar-wrap {
    width: 280px; height: 3px;
    background: rgba(255,255,255,0.08);
    border-radius: 2px; overflow: hidden;
  }
  #loader-bar {
    height: 100%; width: 0%;
    background: linear-gradient(90deg,#FFD700,#FF6B00);
    border-radius: 2px;
    transition: width 0.3s;
  }
  #loader-sub {
    font-size: 11px; letter-spacing: 3px; color: #556;
    font-family: 'Orbitron', monospace;
  }
</style>
</head>
<body>

<div id="loader">
  <h2>INITIALISING SOLAR SYSTEM</h2>
  <div id="loader-bar-wrap"><div id="loader-bar"></div></div>
  <div id="loader-sub">LOADING PLANETARY DATA...</div>
</div>

<div id="canvas-container"></div>

<div id="hud">
  <div id="title-bar">
    <h1>☀ SOLAR SYSTEM — 3D SIMULATION</h1>
    <div id="author-tag">CREATED BY <span>TONNY WANJALA MULATI</span></div>
  </div>

  <div id="info-panel">
    <h2 id="panel-name">SUN</h2>
    <div class="stat">Type: <span id="panel-type">G-type Star</span></div>
    <div class="stat">Diameter: <span id="panel-diam">1,391,000 km</span></div>
    <div class="stat">Orbit Period: <span id="panel-orbit">—</span></div>
    <div class="stat">Day Length: <span id="panel-day">25 Earth Days</span></div>
    <div class="stat">Surface Temp: <span id="panel-temp">5,500 °C</span></div>
  </div>

  <div id="tooltip"></div>

  <div id="speed-bar">
    <label>SPEED</label>
    <input type="range" id="speed-slider" min="0" max="5" step="0.1" value="1">
    <div id="speed-val">1×</div>
  </div>

  <div id="controls">
    <span class="ctrl-key">DRAG</span> Rotate
    <span class="ctrl-key">SCROLL</span> Zoom
    <span class="ctrl-key">CLICK</span> Select
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ─── LOADER PROGRESS ───────────────────────────────────────────────────────
const loaderBar = document.getElementById('loader-bar');
const loaderSub = document.getElementById('loader-sub');
const loader    = document.getElementById('loader');
let loadProgress = 0;
function setLoad(p, msg) {
  loadProgress = p;
  loaderBar.style.width = p + '%';
  if (msg) loaderSub.textContent = msg;
}

// ─── SCENE SETUP ───────────────────────────────────────────────────────────
const container = document.getElementById('canvas-container');
const W = window.innerWidth, H = window.innerHeight;

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(W, H);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 0.9;
container.appendChild(renderer.domElement);

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(55, W / H, 0.1, 20000);
camera.position.set(0, 280, 700);
camera.lookAt(0, 0, 0);

// ─── TEXTURE LOADER ────────────────────────────────────────────────────────
const tl = new THREE.TextureLoader();
// Using NASA/public domain textures via reliable CDNs
const BASE = 'https://raw.githubusercontent.com/mrdoob/three.js/r128/examples/textures/';

// We'll use procedural textures + canvas for planet surfaces
// and supplement with free CDN textures for stars/sun
function makeCanvasTexture(fn, size = 512) {
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = size;
  fn(canvas.getContext('2d'), size);
  return new THREE.CanvasTexture(canvas);
}

// ─── STAR FIELD ────────────────────────────────────────────────────────────
setLoad(10, 'GENERATING STAR FIELD...');
(function buildStars() {
  const geo = new THREE.BufferGeometry();
  const count = 12000;
  const pos = new Float32Array(count * 3);
  const col = new Float32Array(count * 3);
  for (let i = 0; i < count * 3; i += 3) {
    const r = 4000 + Math.random() * 6000;
    const theta = Math.random() * Math.PI * 2;
    const phi   = Math.acos(2 * Math.random() - 1);
    pos[i]   = r * Math.sin(phi) * Math.cos(theta);
    pos[i+1] = r * Math.sin(phi) * Math.sin(theta);
    pos[i+2] = r * Math.cos(phi);
    const t = Math.random();
    col[i]   = t > 0.7 ? 0.9 : t > 0.4 ? 0.8 : 1.0;
    col[i+1] = t > 0.7 ? 0.9 : t > 0.4 ? 1.0 : 0.95;
    col[i+2] = t > 0.7 ? 1.0 : t > 0.4 ? 0.9 : 0.8;
  }
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  geo.setAttribute('color',    new THREE.BufferAttribute(col, 3));
  const mat = new THREE.PointsMaterial({ size: 1.4, vertexColors: true, transparent: true, opacity: 0.9, sizeAttenuation: true });
  scene.add(new THREE.Points(geo, mat));
})();

// ─── NEBULA BACKGROUND ─────────────────────────────────────────────────────
(function buildNebula() {
  const geo = new THREE.BufferGeometry();
  const count = 3000;
  const pos = new Float32Array(count * 3);
  for (let i = 0; i < count * 3; i += 3) {
    const r = 3500 + Math.random() * 2000;
    const theta = Math.random() * Math.PI * 2;
    const phi   = Math.acos(2 * Math.random() - 1);
    pos[i]   = r * Math.sin(phi) * Math.cos(theta);
    pos[i+1] = r * Math.sin(phi) * Math.sin(theta) * 0.3;
    pos[i+2] = r * Math.cos(phi);
  }
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const mat = new THREE.PointsMaterial({ size: 3, color: 0x223355, transparent: true, opacity: 0.25 });
  scene.add(new THREE.Points(geo, mat));
})();

// ─── LIGHTING ──────────────────────────────────────────────────────────────
setLoad(20, 'PLACING STELLAR BODIES...');
const sunLight = new THREE.PointLight(0xFFF5E0, 3.5, 4000, 1.5);
sunLight.castShadow = true;
sunLight.shadow.mapSize.set(2048, 2048);
scene.add(sunLight);
scene.add(new THREE.AmbientLight(0x111133, 0.6));

// ─── PLANET DATA ───────────────────────────────────────────────────────────
const PLANET_DATA = [
  {
    name: 'Mercury', type: 'Rocky Planet',
    radius: 4.8, orbitR: 90, speed: 4.15, tilt: 0.034, rotSpeed: 0.004,
    color1: '#a09080', color2: '#7a6a5a', color3: '#b0a090',
    texture: 'mercury', diam: '4,879 km', orbit: '88 Earth Days', day: '58.6 Earth Days', temp: '430 °C / −180 °C',
    emissive: 0x111111
  },
  {
    name: 'Venus', type: 'Rocky Planet',
    radius: 7.5, orbitR: 140, speed: 1.62, tilt: 177.4, rotSpeed: 0.002,
    color1: '#e8c070', color2: '#c09040', color3: '#f0d080',
    texture: 'venus', diam: '12,104 km', orbit: '225 Earth Days', day: '243 Earth Days', temp: '465 °C',
    emissive: 0x221100
  },
  {
    name: 'Earth', type: 'Rocky Planet',
    radius: 8, orbitR: 200, speed: 1.0, tilt: 23.4, rotSpeed: 0.01,
    color1: '#2266bb', color2: '#1a8844', color3: '#44aaff',
    texture: 'earth', diam: '12,742 km', orbit: '365.25 Days', day: '24 Hours', temp: '15 °C avg',
    emissive: 0x001122, hasMoon: true
  },
  {
    name: 'Mars', type: 'Rocky Planet',
    radius: 5.5, orbitR: 265, speed: 0.53, tilt: 25.2, rotSpeed: 0.0097,
    color1: '#cc4422', color2: '#aa3311', color3: '#ee6644',
    texture: 'mars', diam: '6,779 km', orbit: '687 Earth Days', day: '24.6 Hours', temp: '−63 °C avg',
    emissive: 0x220800
  },
  {
    name: 'Jupiter', type: 'Gas Giant',
    radius: 28, orbitR: 390, speed: 0.084, tilt: 3.1, rotSpeed: 0.024,
    color1: '#c89060', color2: '#e8b080', color3: '#a07040',
    texture: 'jupiter', diam: '139,820 km', orbit: '11.9 Earth Years', day: '9.9 Hours', temp: '−145 °C',
    emissive: 0x110800, bands: true
  },
  {
    name: 'Saturn', type: 'Gas Giant',
    radius: 22, orbitR: 520, speed: 0.034, tilt: 26.7, rotSpeed: 0.022,
    color1: '#d4b870', color2: '#c0a050', color3: '#e8cc80',
    texture: 'saturn', diam: '116,460 km', orbit: '29.5 Earth Years', day: '10.7 Hours', temp: '−178 °C',
    emissive: 0x110a00, rings: true, bands: true
  },
  {
    name: 'Uranus', type: 'Ice Giant',
    radius: 14, orbitR: 660, speed: 0.012, tilt: 97.8, rotSpeed: 0.014,
    color1: '#70c8d8', color2: '#50aabc', color3: '#90dde8',
    texture: 'uranus', diam: '50,724 km', orbit: '84 Earth Years', day: '17.2 Hours', temp: '−224 °C',
    emissive: 0x002233, rings: true, thinRings: true
  },
  {
    name: 'Neptune', type: 'Ice Giant',
    radius: 13, orbitR: 800, speed: 0.006, tilt: 28.3, rotSpeed: 0.015,
    color1: '#2244cc', color2: '#1133aa', color3: '#3355ee',
    texture: 'neptune', diam: '49,244 km', orbit: '165 Earth Years', day: '16.1 Hours', temp: '−214 °C',
    emissive: 0x001133
  },
  {
    name: 'Pluto', type: 'Dwarf Planet',
    radius: 2.5, orbitR: 950, speed: 0.004, tilt: 122, rotSpeed: 0.003,
    color1: '#c8a888', color2: '#a08868', color3: '#d8b898',
    texture: 'pluto', diam: '2,376 km', orbit: '248 Earth Years', day: '6.4 Earth Days', temp: '−229 °C',
    emissive: 0x110800
  }
];

// ─── TEXTURE GENERATORS ────────────────────────────────────────────────────
function genPlanetTexture(data, size = 512) {
  return makeCanvasTexture((ctx, s) => {
    const c1 = data.color1, c2 = data.color2, c3 = data.color3;
    // Base gradient
    const bg = ctx.createLinearGradient(0, 0, s, s);
    bg.addColorStop(0, c1); bg.addColorStop(0.5, c2); bg.addColorStop(1, c3);
    ctx.fillStyle = bg; ctx.fillRect(0, 0, s, s);

    if (data.bands) {
      // Atmospheric banding (Jupiter/Saturn)
      const bandColors = data.name === 'Jupiter'
        ? ['#e8c090','#c08040','#f0d0a0','#a06030','#d8b070','#b87840']
        : ['#e8d890','#c8b060','#f0e0a0','#b09050','#e0cc80'];
      for (let i = 0; i < 20; i++) {
        const y = (i / 20) * s;
        const h = (s / 20) + Math.random() * 4;
        ctx.fillStyle = bandColors[i % bandColors.length];
        ctx.globalAlpha = 0.35 + Math.random() * 0.3;
        ctx.fillRect(0, y, s, h);
      }
      ctx.globalAlpha = 1;
    }

    if (data.texture === 'earth') {
      // Continents
      ctx.fillStyle = '#2d8a50';
      const continents = [
        [0.15,0.3,0.18,0.25], [0.4,0.2,0.15,0.3], [0.6,0.35,0.12,0.22],
        [0.25,0.55,0.2,0.2], [0.7,0.6,0.15,0.25], [0.05,0.1,0.1,0.15]
      ];
      continents.forEach(([x,y,w,h]) => {
        ctx.globalAlpha = 0.85;
        ctx.beginPath();
        ctx.ellipse(x*s, y*s, w*s, h*s, Math.random(), 0, Math.PI*2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;
      // Ice caps
      ctx.fillStyle = '#e8f0ff';
      ctx.fillRect(0, 0, s, s * 0.05);
      ctx.fillRect(0, s * 0.93, s, s * 0.07);
      // Cloud wisps
      ctx.fillStyle = 'rgba(255,255,255,0.3)';
      for (let i = 0; i < 15; i++) {
        ctx.beginPath();
        ctx.ellipse(Math.random()*s, Math.random()*s, 20+Math.random()*60, 4+Math.random()*12, Math.random()*Math.PI, 0, Math.PI*2);
        ctx.fill();
      }
    }

    if (data.texture === 'mars') {
      // Polar caps
      ctx.fillStyle = '#f8f0e0'; ctx.globalAlpha = 0.7;
      ctx.fillRect(0, 0, s, s * 0.08);
      ctx.fillRect(0, s * 0.91, s, s * 0.09);
      ctx.globalAlpha = 1;
      // Craters
      for (let i = 0; i < 20; i++) {
        const cx = Math.random()*s, cy = Math.random()*s, cr = 3+Math.random()*18;
        ctx.strokeStyle = 'rgba(80,30,10,0.5)'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(cx, cy, cr, 0, Math.PI*2); ctx.stroke();
      }
    }

    if (data.texture === 'mercury') {
      for (let i = 0; i < 40; i++) {
        const cx = Math.random()*s, cy = Math.random()*s, cr = 2+Math.random()*14;
        ctx.strokeStyle = 'rgba(60,40,20,0.5)'; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(cx, cy, cr, 0, Math.PI*2); ctx.stroke();
        ctx.fillStyle = 'rgba(50,35,20,0.2)';
        ctx.beginPath(); ctx.arc(cx, cy, cr, 0, Math.PI*2); ctx.fill();
      }
    }

    if (data.texture === 'venus') {
      // Swirling clouds
      for (let i = 0; i < 12; i++) {
        const y = (i/12)*s;
        ctx.fillStyle = `rgba(240,200,80,${0.2+Math.random()*0.25})`;
        ctx.beginPath();
        ctx.ellipse(Math.random()*s, y, 80+Math.random()*100, 8+Math.random()*16, Math.random(), 0, Math.PI*2);
        ctx.fill();
      }
    }

    if (data.texture === 'uranus' || data.texture === 'neptune') {
      // Subtle swirl
      for (let i = 0; i < 8; i++) {
        const y = (i/8)*s;
        ctx.fillStyle = `rgba(255,255,255,${0.05+Math.random()*0.1})`;
        ctx.fillRect(0, y, s, 6+Math.random()*10);
      }
    }

    // Noise overlay for realism
    for (let i = 0; i < 4000; i++) {
      const x = Math.random()*s, y = Math.random()*s;
      const v = Math.random()*0.15;
      ctx.fillStyle = `rgba(${Math.random()>0.5?255:0},${Math.random()>0.5?255:0},${Math.random()>0.5?255:0},${v})`;
      ctx.fillRect(x, y, 1, 1);
    }
  }, size);
}

function genSunTexture(size = 1024) {
  return makeCanvasTexture((ctx, s) => {
    const g = ctx.createRadialGradient(s/2, s/2, 0, s/2, s/2, s/2);
    g.addColorStop(0,   '#ffffff');
    g.addColorStop(0.15,'#fff8c0');
    g.addColorStop(0.4, '#ffdd00');
    g.addColorStop(0.7, '#ff8800');
    g.addColorStop(1,   '#ff4400');
    ctx.fillStyle = g; ctx.fillRect(0, 0, s, s);
    // Sunspots + granules
    ctx.globalAlpha = 0.12;
    for (let i = 0; i < 6000; i++) {
      const x = Math.random()*s, y = Math.random()*s, r = Math.random()*3;
      const v = Math.random();
      ctx.fillStyle = v > 0.5 ? '#ffffff' : '#ff6600';
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 0.5;
    for (let i = 0; i < 8; i++) {
      const x = 0.2*s + Math.random()*0.6*s, y = 0.2*s + Math.random()*0.6*s;
      ctx.fillStyle = 'rgba(80,20,0,0.6)';
      ctx.beginPath(); ctx.arc(x, y, 8+Math.random()*22, 0, Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }, size);
}

function genRingTexture(inner, outer, size = 512) {
  return makeCanvasTexture((ctx, s) => {
    for (let r = inner; r < outer; r += 0.5) {
      const t = (r - inner) / (outer - inner);
      const alpha = (Math.sin(t * Math.PI * 8) * 0.3 + 0.5) * (1 - Math.abs(t - 0.5) * 1.2);
      ctx.strokeStyle = `rgba(220,200,140,${Math.max(0,alpha * 0.7)})`;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(s/2, s/2, r, 0, Math.PI * 2); ctx.stroke();
    }
  }, size);
}

// ─── BUILD SUN ─────────────────────────────────────────────────────────────
setLoad(35, 'IGNITING THE SUN...');
const sunGeo = new THREE.SphereGeometry(55, 64, 64);
const sunMat = new THREE.MeshBasicMaterial({ map: genSunTexture() });
const sun = new THREE.Mesh(sunGeo, sunMat);
scene.add(sun);

// Sun corona glow (multiple halos)
[120, 90, 75].forEach((r, i) => {
  const coronaGeo = new THREE.SphereGeometry(r, 32, 32);
  const coronaMat = new THREE.MeshBasicMaterial({
    color: new THREE.Color(i === 0 ? 0xff4400 : i === 1 ? 0xff8800 : 0xffcc00),
    transparent: true, opacity: [0.03, 0.06, 0.1][i],
    side: THREE.BackSide
  });
  scene.add(new THREE.Mesh(coronaGeo, coronaMat));
});

// ─── BUILD PLANETS ─────────────────────────────────────────────────────────
setLoad(50, 'ASSEMBLING PLANETS...');
const planetObjects = [];
const orbitLines = [];

PLANET_DATA.forEach((data, idx) => {
  // Orbit line
  const orbitPoints = [];
  for (let a = 0; a <= Math.PI * 2; a += 0.03) {
    orbitPoints.push(new THREE.Vector3(Math.cos(a) * data.orbitR, 0, Math.sin(a) * data.orbitR));
  }
  const orbitGeo = new THREE.BufferGeometry().setFromPoints(orbitPoints);
  const orbitMat = new THREE.LineBasicMaterial({
    color: 0x334466, transparent: true, opacity: 0.35
  });
  scene.add(new THREE.LineLoop(orbitGeo, orbitMat));
  orbitLines.push(orbitMat);

  // Planet sphere
  const geo = new THREE.SphereGeometry(data.radius, 48, 48);
  const mat = new THREE.MeshStandardMaterial({
    map: genPlanetTexture(data),
    roughness: 0.85,
    metalness: 0.05,
    emissive: new THREE.Color(data.emissive),
    emissiveIntensity: 0.15
  });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.receiveShadow = true;
  mesh.castShadow = true;
  mesh.rotation.z = THREE.MathUtils.degToRad(data.tilt);
  mesh.userData = { ...data, angle: Math.random() * Math.PI * 2, idx };

  // Atmosphere (inner planets + gas giants)
  if (['earth','venus','uranus','neptune'].includes(data.texture)) {
    const atmoGeo = new THREE.SphereGeometry(data.radius * 1.06, 32, 32);
    const atmoColors = { earth: 0x4488ff, venus: 0xddaa44, uranus: 0x66bbcc, neptune: 0x2244cc };
    const atmoMat = new THREE.MeshBasicMaterial({
      color: atmoColors[data.texture] || 0x4488ff,
      transparent: true, opacity: 0.09, side: THREE.BackSide
    });
    const atmo = new THREE.Mesh(atmoGeo, atmoMat);
    mesh.add(atmo);
  }

  // Saturn / Uranus rings
  if (data.rings) {
    const isThin = data.thinRings;
    const ri = data.radius * (isThin ? 1.4 : 1.3);
    const ro = data.radius * (isThin ? 2.0 : 2.5);
    const ringGeo = new THREE.RingGeometry(ri, ro, 128);
    // UV fix
    const pos2 = ringGeo.attributes.position;
    const uv2  = ringGeo.attributes.uv;
    for (let i = 0; i < pos2.count; i++) {
      const x = pos2.getX(i), y = pos2.getY(i);
      const d = Math.sqrt(x*x + y*y);
      uv2.setXY(i, (d - ri) / (ro - ri), 0.5);
    }
    const ringMat = new THREE.MeshBasicMaterial({
      map: genRingTexture(ri * 10, ro * 10),
      side: THREE.DoubleSide,
      transparent: true, opacity: isThin ? 0.35 : 0.75
    });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.x = Math.PI / 2.3;
    if (isThin) ring.rotation.x = Math.PI / 2.1;
    mesh.add(ring);
  }

  // Earth moon
  if (data.hasMoon) {
    const moonGeo = new THREE.SphereGeometry(2, 24, 24);
    const moonMat = new THREE.MeshStandardMaterial({
      map: makeCanvasTexture((ctx, s) => {
        ctx.fillStyle = '#aaa8a0'; ctx.fillRect(0,0,s,s);
        for (let i = 0; i < 25; i++) {
          ctx.strokeStyle = `rgba(80,80,70,0.5)`; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.arc(Math.random()*s, Math.random()*s, 4+Math.random()*14, 0, Math.PI*2); ctx.stroke();
        }
      }, 256),
      roughness: 0.9, metalness: 0
    });
    const moon = new THREE.Mesh(moonGeo, moonMat);
    moon.userData.isMoon = true;
    moon.userData.orbitR = data.radius * 2.8;
    moon.userData.moonAngle = 0;
    moon.userData.moonSpeed = 0.025;
    mesh.add(moon);
  }

  scene.add(mesh);
  planetObjects.push(mesh);
});

// ─── ASTEROID BELT ─────────────────────────────────────────────────────────
setLoad(70, 'SEEDING ASTEROID BELT...');
(function buildAsteroidBelt() {
  const beltGeo = new THREE.BufferGeometry();
  const count = 1800;
  const pos = new Float32Array(count * 3);
  for (let i = 0; i < count * 3; i += 3) {
    const r = 310 + Math.random() * 50;
    const a = Math.random() * Math.PI * 2;
    pos[i]   = Math.cos(a) * r;
    pos[i+1] = (Math.random() - 0.5) * 8;
    pos[i+2] = Math.sin(a) * r;
  }
  beltGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const beltMat = new THREE.PointsMaterial({ size: 0.9, color: 0x887766, transparent: true, opacity: 0.6 });
  scene.add(new THREE.Points(beltGeo, beltMat));
})();

// ─── CAMERA ORBIT CONTROLS (manual) ───────────────────────────────────────
setLoad(85, 'CALIBRATING CAMERA...');
let isDragging = false, prevMouse = { x: 0, y: 0 };
let spherical = { theta: 0, phi: Math.PI / 3.5, r: 700 };
const minR = 80, maxR = 2200;

function updateCamera() {
  camera.position.set(
    spherical.r * Math.sin(spherical.phi) * Math.sin(spherical.theta),
    spherical.r * Math.cos(spherical.phi),
    spherical.r * Math.sin(spherical.phi) * Math.cos(spherical.theta)
  );
  camera.lookAt(0, 0, 0);
}
updateCamera();

renderer.domElement.addEventListener('mousedown', e => { isDragging = true; prevMouse = { x: e.clientX, y: e.clientY }; });
window.addEventListener('mouseup', () => { isDragging = false; });
window.addEventListener('mousemove', e => {
  if (!isDragging) return;
  const dx = e.clientX - prevMouse.x, dy = e.clientY - prevMouse.y;
  spherical.theta -= dx * 0.005;
  spherical.phi = Math.max(0.08, Math.min(Math.PI - 0.08, spherical.phi + dy * 0.005));
  prevMouse = { x: e.clientX, y: e.clientY };
  updateCamera();
});
renderer.domElement.addEventListener('wheel', e => {
  spherical.r = Math.max(minR, Math.min(maxR, spherical.r + e.deltaY * 0.6));
  updateCamera();
}, { passive: true });

// Touch
let lastTouch = null, lastPinchDist = 0;
renderer.domElement.addEventListener('touchstart', e => {
  if (e.touches.length === 1) { isDragging = true; lastTouch = { x: e.touches[0].clientX, y: e.touches[0].clientY }; }
  if (e.touches.length === 2) {
    lastPinchDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
  }
}, { passive: true });
renderer.domElement.addEventListener('touchend', () => { isDragging = false; }, { passive: true });
renderer.domElement.addEventListener('touchmove', e => {
  if (e.touches.length === 1 && isDragging && lastTouch) {
    const dx = e.touches[0].clientX - lastTouch.x, dy = e.touches[0].clientY - lastTouch.y;
    spherical.theta -= dx * 0.006;
    spherical.phi = Math.max(0.08, Math.min(Math.PI - 0.08, spherical.phi + dy * 0.006));
    lastTouch = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    updateCamera();
  }
  if (e.touches.length === 2) {
    const d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
    spherical.r = Math.max(minR, Math.min(maxR, spherical.r - (d - lastPinchDist) * 1.5));
    lastPinchDist = d;
    updateCamera();
  }
}, { passive: true });

// ─── RAYCASTING FOR CLICK/HOVER ────────────────────────────────────────────
const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();
const tooltip = document.getElementById('tooltip');
let selectedPlanet = null;

function getPlanetInfo(data) {
  document.getElementById('panel-name').textContent = data.name.toUpperCase();
  document.getElementById('panel-type').textContent = data.type || '—';
  document.getElementById('panel-diam').textContent = data.diam || '—';
  document.getElementById('panel-orbit').textContent = data.orbit || '—';
  document.getElementById('panel-day').textContent = data.day || '—';
  document.getElementById('panel-temp').textContent = data.temp || '—';
}

renderer.domElement.addEventListener('mousemove', e => {
  mouse.set((e.clientX / W) * 2 - 1, -(e.clientY / H) * 2 + 1);
  raycaster.setFromCamera(mouse, camera);
  const hits = raycaster.intersectObjects(planetObjects);
  if (hits.length > 0) {
    const obj = hits[0].object;
    const ud = obj.userData;
    tooltip.style.display = 'block';
    tooltip.style.left = e.clientX + 'px';
    tooltip.style.top  = e.clientY + 'px';
    tooltip.textContent = ud.name ? ud.name.toUpperCase() : 'PLANET';
    document.body.style.cursor = 'pointer';
  } else {
    tooltip.style.display = 'none';
    document.body.style.cursor = isDragging ? 'grabbing' : 'grab';
  }
});

renderer.domElement.addEventListener('click', e => {
  mouse.set((e.clientX / W) * 2 - 1, -(e.clientY / H) * 2 + 1);
  raycaster.setFromCamera(mouse, camera);
  const hits = raycaster.intersectObjects([sun, ...planetObjects]);
  if (hits.length > 0) {
    const ud = hits[0].object.userData;
    if (ud.name) getPlanetInfo(ud);
    else getPlanetInfo({ name: 'Sun', type: 'G-type Star', diam: '1,391,000 km', orbit: '—', day: '25 Earth Days', temp: '5,500 °C' });
  }
});

// Clicking sun
renderer.domElement.addEventListener('click', e => {
  mouse.set((e.clientX / W) * 2 - 1, -(e.clientY / H) * 2 + 1);
  raycaster.setFromCamera(mouse, camera);
  if (raycaster.intersectObject(sun).length > 0) {
    getPlanetInfo({ name: 'Sun', type: 'G-type Star', diam: '1,391,000 km', orbit: '—', day: '25 Earth Days', temp: '5,500 °C' });
  }
});

// ─── SPEED CONTROL ─────────────────────────────────────────────────────────
let speedMult = 1;
const slider = document.getElementById('speed-slider');
const speedVal = document.getElementById('speed-val');
slider.addEventListener('input', () => {
  speedMult = parseFloat(slider.value);
  speedVal.textContent = speedMult.toFixed(1) + '×';
});
slider.style.pointerEvents = 'all';

// ─── ANIMATION LOOP ────────────────────────────────────────────────────────
setLoad(95, 'LAUNCHING SIMULATION...');
const clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const dt = clock.getDelta() * speedMult;

  // Rotate sun
  sun.rotation.y += 0.002 * speedMult;

  // Orbit & rotate planets
  planetObjects.forEach(mesh => {
    const ud = mesh.userData;
    ud.angle += ud.speed * 0.005 * speedMult;
    mesh.position.x = Math.cos(ud.angle) * ud.orbitR;
    mesh.position.z = Math.sin(ud.angle) * ud.orbitR;
    mesh.rotation.y += ud.rotSpeed * speedMult;

    // Moon orbit
    mesh.children.forEach(child => {
      if (child.userData && child.userData.isMoon) {
        child.userData.moonAngle += child.userData.moonSpeed * speedMult;
        const ma = child.userData.moonAngle;
        const mr = child.userData.orbitR;
        child.position.set(Math.cos(ma) * mr, 0, Math.sin(ma) * mr);
      }
    });
  });

  renderer.render(scene, camera);
}

// ─── RESIZE ────────────────────────────────────────────────────────────────
window.addEventListener('resize', () => {
  const W2 = window.innerWidth, H2 = window.innerHeight;
  camera.aspect = W2 / H2; camera.updateProjectionMatrix();
  renderer.setSize(W2, H2);
});

// ─── LAUNCH ────────────────────────────────────────────────────────────────
setTimeout(() => {
  setLoad(100, 'READY');
  setTimeout(() => {
    loader.style.transition = 'opacity 0.8s';
    loader.style.opacity = '0';
    setTimeout(() => loader.style.display = 'none', 850);
    animate();
  }, 300);
}, 800);

// Default panel to Sun
getPlanetInfo({ name: 'Sun', type: 'G-type Star', diam: '1,391,000 km', orbit: '—', day: '25 Earth Days', temp: '5,500 °C' });
</script>
